// -- ELEMENTS

html
{
    height: 100%;
    min-height: 100%;

    font-size: 1rem;
}

@media ( min-width: 90em )
{
    html
    {
        font-size: 1.1rem;
    }
}

@media ( min-width: 100em )
{
    html
    {
        font-size: 1.2rem;
    }
}

@media ( min-width: 110em )
{
    html
    {
        font-size: 1.3rem;
    }
}

@media ( min-width: 120em )
{
    html
    {
        font-size: 1.4rem;
    }
}

body
{
    height: 100%;
    min-height: 100%;

    background-color: whiteColor;

    color: blackColor;
}

body,
button,
input,
textarea
{
    font-family: sans-serif;
    font-weight: 400;
}

a
{
    text-decoration: none;
    color: inherit;
}

sup
{
    position: relative;
    top: -0.7em;

    font-size: 0.5em;
    vertical-align: baseline;
}

table
{
    margin-top: 1rem;
    margin-bottom: 1rem;
    border-collapse: collapse;
}

table tr:first-child
{
    font-weight: 700;
    text-align: center;
}

td
{
    border: 1px solid tableBorderColor;
    padding: 0.5rem;
}
