// -- CLASSES

.error-page
{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80dvh;
    padding: 2rem;
    text-align: center;
}

.error-page-logo
{
    width: 8rem;
    height: auto;
    margin-bottom: 1.5rem;
}

.error-page-title
{
    font-size: 2rem;
    margin-bottom: 1rem;
}

.error-page-text
{
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
}

.error-page-link
{
    font-size: 1rem;
    text-decoration: underline;
}
