                </div>
                <div class="home-page-feature">
                    <div class="home-page-feature-icon">${input.pageData.homePage.feature2Icon}</div>
                    <h3 class="home-page-feature-title">
                        ${getLocalizedText( input.pageData.homePage.feature2Title as string, input.pageData.languageTag )}
