                    <p class="home-page-feature-description">
                        ${getLocalizedText( input.pageData.homePage.feature2Description as string, input.pageData.languageTag )}
                    </p>
                </div>
                <div class="home-page-feature">
                    <div class="home-page-feature-icon">${input.pageData.homePage.feature3Icon}</div>
                    <h3 class="home-page-feature-title">
                        ${getLocalizedText( input.pageData.homePage.feature3Title as string, input.pageData.languageTag )}
                    </h3>
                    <p class="home-page-feature-description">
                        ${getLocalizedText( input.pageData.homePage.feature3Description as string, input.pageData.languageTag )}
                    </p>
                </div>
            </div>
        </div>
